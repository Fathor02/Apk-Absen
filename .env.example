# AbsenSiswa — konfigurasi
# SALIN FILE INI SEBAGAI .env

# Kredensial Supabase (wajib untuk mode sinkron)
# Dari Supabase Dashboard: Project Settings -> API
# Aplikasi dibuka lewat: node server.js  (membaca .env ini langsung)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Kredensial login admin (divalidasi di server, bukan di kode klien)
# Ganti nilai ini di produksi
ADMIN_USER=admin
ADMIN_PASS=ganti-password-kamu
